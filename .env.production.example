# Production-like environment for Docker Compose
APP_NAME=MailCraft
DEBUG=false
HOST=0.0.0.0
PORT=8081

GOOGLE_API_KEY=replace-me
GOOGLE_MODEL_A=gemini-2.5-flash
GOOGLE_MODEL_B=gemini-2.5-flash
GOOGLE_JUDGE_MODEL=gemini-2.5-flash

DATABASE_URL=postgresql+psycopg://mailcraft:mailcraft@db:5432/mailcraft
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

UPLOAD_MAX_MB=10
UPLOAD_DIR=/app/data/uploads

HUMANIZE_CONTENT_ENABLED=true
HUMANIZE_MODEL=

RUN_MIGRATIONS_ON_STARTUP=false
RATE_LIMIT_ENABLED=true

LOG_FORMAT=json
LOG_LEVEL=INFO
HEALTH_CHECK_LLM_ENABLED=false
STORAGE_BACKEND=local
STORE_UPLOADED_RESUMES=false
GENERATION_ASYNC_ENABLED=false
REDIS_URL=redis://redis:6379/0
