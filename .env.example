# Application
APP_NAME=MailCraft
DEBUG=false

# Google GenAI
GOOGLE_API_KEY=

# Strategy email generation
GOOGLE_MODEL_A=gemini-2.5-flash
GOOGLE_MODEL_B=gemini-2.5-flash

# LLM-as-judge for evaluation metrics
GOOGLE_JUDGE_MODEL=gemini-2.5-flash

# Pause between LLM API calls (seconds). Evaluation defaults to 4s when unset.
# Set to 0 to disable throttling for interactive API usage.
LLM_REQUEST_DELAY_SECONDS=4

# Stateful platform (SQLite + auth)
DATABASE_URL=sqlite:///./data/mailcraft.db
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
UPLOAD_MAX_MB=10
UPLOAD_DIR=./data/uploads

# Humanize AI-generated content after the main generation pass
HUMANIZE_CONTENT_ENABLED=true
# Optional override model; defaults to GOOGLE_MODEL_A when empty
HUMANIZE_MODEL=
