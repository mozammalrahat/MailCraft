# Application
APP_NAME=MailCraft
DEBUG=false
HOST=127.0.0.1
PORT=8081

# Google GenAI
GOOGLE_API_KEY=

# Strategy email generation
GOOGLE_MODEL_A=gemini-2.5-flash
GOOGLE_MODEL_B=gemini-2.5-flash

# LLM-as-judge for evaluation metrics
GOOGLE_JUDGE_MODEL=gemini-2.5-flash

# Pause between LLM API calls (seconds). Evaluation defaults to 4s when unset.
# Set to 0 to disable throttling for interactive API usage.
LLM_REQUEST_DELAY_SECONDS=4

# Stateful platform
# Development / tests: SQLite
DATABASE_URL=sqlite:///./data/mailcraft.db
# Production example:
# DATABASE_URL=postgresql+psycopg://mailcraft:mailcraft@db:5432/mailcraft

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
UPLOAD_MAX_MB=10
UPLOAD_DIR=./data/uploads

# Run Alembic on app startup (dev convenience). Set false in production Docker.
RUN_MIGRATIONS_ON_STARTUP=true

# Rate limiting on auth and generation endpoints
RATE_LIMIT_ENABLED=true

# Humanize AI-generated content after the main generation pass
HUMANIZE_CONTENT_ENABLED=true
# Optional override model; defaults to GOOGLE_MODEL_A when empty
HUMANIZE_MODEL=

# Logging (Phase D)
LOG_FORMAT=json
LOG_LEVEL=INFO

# Readiness checks
HEALTH_CHECK_LLM_ENABLED=false
HEALTH_CHECK_LLM_TIMEOUT_SECONDS=2

# File storage
STORAGE_BACKEND=local
STORE_UPLOADED_RESUMES=false
# S3-compatible storage (when STORAGE_BACKEND=s3)
# S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=

# Async generation worker (requires Redis + mailcraft-worker)
GENERATION_ASYNC_ENABLED=false
REDIS_URL=redis://localhost:6379/0
